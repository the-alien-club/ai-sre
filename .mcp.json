{
  "mcpServers": {
    "signoz-webhook": {
      "command": "bun",
      "args": ["./channels/signoz-webhook.ts"]
    },
    "slack-sre": {
      "command": "bun",
      "args": ["./channels/slack-sre.ts"]
    },
    "trivy-webhook": {
      "command": "bun",
      "args": ["./channels/trivy-webhook.ts"]
    },
    "signoz": {
      "command": "npx",
      "args": ["signoz-mcp-server"],
      "env": {
        "SIGNOZ_URL": "${SIGNOZ_URL}",
        "SIGNOZ_TOKEN": "${SIGNOZ_TOKEN}"
      }
    }
  }
}