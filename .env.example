# SigNoz Webhook Channel
SIGNOZ_WEBHOOK_PORT=8788
SIGNOZ_WEBHOOK_HOST=0.0.0.0
SIGNOZ_WEBHOOK_TOKEN=your-shared-secret-here

# Trivy Webhook Channel (security findings from Trivy operator)
TRIVY_WEBHOOK_PORT=8790
TRIVY_WEBHOOK_HOST=0.0.0.0
TRIVY_WEBHOOK_TOKEN=your-trivy-shared-secret

# Slack SRE Channel
# Create a Slack app at https://api.slack.com/apps
# Enable Socket Mode, add connections:write scope to App-Level Token
# Bot Token Scopes: chat:write, chat:write.public, channels:history, channels:read,
#                   channels:join, im:history, im:read, im:write
#                   (add groups:history, groups:read if the team channel is private)
# Event Subscriptions → Subscribe to bot events: message.channels, message.im
#                   (do NOT also add app_mention — mentions already arrive as message.channels)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# The channel the agent lives in. Escalations, permission requests and reports go here.
# Get the ID from the channel's "View channel details" → bottom of the About tab.
SRE_SLACK_CHANNEL=C09MWNB6WL8

# Operator allowlist: "<slack_user_id>:<display_name>", comma-separated.
# These are the ONLY users the agent listens to, and the only ones who may approve
# or deny permission requests. Everyone else in the channel is ignored.
# Find a user ID via their profile → three dots → Copy member ID.
SRE_OPERATORS=U054PDMV69X:Leo,U059X19MH8U:Adrien,U09KNNY8GGJ:Ghislain

# Escalation Timing (milliseconds)
ESCALATION_INTERVAL_MS=600000
DEV_ESCALATION_INTERVAL_MS=3600000
