# SigNoz Webhook Channel
# The webhook channels listen on loopback only; Caddy terminates TLS and forwards to them
# (INSTALL.md §9b). Binding a public address would expose the secret in cleartext.
SIGNOZ_WEBHOOK_PORT=8788
SIGNOZ_WEBHOOK_HOST=127.0.0.1
SIGNOZ_WEBHOOK_TOKEN=your-shared-secret-here

# Sentinel remediation (required by the SigNoz channel; it refuses to start without them).
# A stage-1 sentinel alert labelled sentinel_class=remediable is not handed to Claude: the
# channel runs the Rundeck job it names (allowlist: channels/sentinel-remediation.json) on
# VM-A's Rundeck, once per firing episode, and the job reports to #alerts-ops itself.
# Rundeck has no TLS: it is reached only over the WireGuard link to VM-A (agent 10.66.0.2,
# VM-A 10.66.0.1), on k3s NodePort 30440. Plain http is accepted only to a private address.
RUNDECK_URL=http://10.66.0.1:30440
# The static token of Rundeck user `sre-agent` (role sre-agent: read and run jobs in group
# `actions` of project `sentinel`, nothing else). Bitwarden item vm-a-rundeck-sentinel,
# property TOKEN_SRE_AGENT. Rundeck reads its tokens only at startup.
RUNDECK_API_TOKEN=your-rundeck-sre-agent-token

# Trivy Webhook Channel (security findings from Trivy operator)
TRIVY_WEBHOOK_PORT=8790
TRIVY_WEBHOOK_HOST=127.0.0.1
TRIVY_WEBHOOK_TOKEN=your-trivy-shared-secret

# The Trivy channel posts its own findings to the team channel (SLACK_BOT_TOKEN,
# SRE_SLACK_CHANNEL and SRE_OPERATORS below) and files one Jira ticket per image (JIRA_*
# below); it refuses to start without them. The daily digest goes out at this UTC hour.
TRIVY_DIGEST_HOUR_UTC=7

# Jira (required by the Trivy channel). An Atlassian API token for an account that can
# create and comment on SDS issues: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://alien-team-ds.atlassian.net
JIRA_USER_EMAIL=sre-agent@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# Slack SRE Channel
# Create a Slack app at https://api.slack.com/apps
# Enable Socket Mode, add connections:write scope to App-Level Token
# Bot Token Scopes: chat:write, chat:write.public, channels:history, channels:read,
#                   channels:join, im:history, im:read, im:write
#                   (add groups:history, groups:read if the team channel is private)
# Event Subscriptions → Subscribe to bot events: message.channels, message.im
#                   (do NOT also add app_mention — mentions already arrive as message.channels)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# The channel the agent lives in. Escalations, permission requests and reports go here.
# Get the ID from the channel's "View channel details" → bottom of the About tab.
SRE_SLACK_CHANNEL=C09MWNB6WL8

# Operator allowlist: "<slack_user_id>:<display_name>", comma-separated.
# These are the ONLY users the agent listens to, and the only ones who may approve
# or deny permission requests. Everyone else in the channel is ignored.
# Find a user ID via their profile → three dots → Copy member ID.
SRE_OPERATORS=U054PDMV69X:Leo,U059X19MH8U:Adrien,U09KNNY8GGJ:Ghislain

# SigNoz MCP server (the agent's query access to logs, traces and metrics).
# .mcp.json reads these by reference, so the key lives only in this git-ignored file;
# never paste it into .mcp.json, which is tracked and overwritten on every deploy.
SIGNOZ_URL=https://your-signoz-instance.signoz.cloud
SIGNOZ_TOKEN=your-signoz-api-key

# Escalation Timing (milliseconds)
ESCALATION_INTERVAL_MS=600000
DEV_ESCALATION_INTERVAL_MS=3600000

# How long the agent may stay silent after an operator writes before the channel posts a
# short "on it" in that thread on its behalf. The agent delegates investigation to
# sub-agents, so a real question is quiet for minutes — and from Slack that looks like a
# dead bot. Set to 0 to disable. Default: 20000.
ACK_DELAY_MS=20000

# Where the channels persist state that only they know about: the escalation nag timers
# (slack-escalations.json), the Trivy digest, tickets and secrets (trivy-findings.json) and the
# sentinel remediations already run (sentinel-remediations.json). Defaults to the repo's data/ directory, alongside
# incidents.db. Must survive a restart — this is what keeps an unacknowledged critical
# alert nagging across the nightly `pm2 restart`.
# SRE_DATA_DIR=/home/sre-agent/sre-agent/data
